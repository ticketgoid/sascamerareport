<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="#FFFFFF"
    android:orientation="vertical"
    android:padding="24dp">

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginBottom="16dp"
        android:text="Lengkapi Data Foto"
        android:textColor="#000000"
        android:textSize="20sp"
        android:textStyle="bold" />

    <EditText
        android:id="@+id/etNamaWarung"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginBottom="12dp"
        android:hint="Nama Warung"
        android:inputType="textCapWords"
        android:textColor="#000000" />

    <EditText
        android:id="@+id/etNoWa"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginBottom="12dp"
        android:hint="Nomor WhatsApp"
        android:inputType="phone"
        android:textColor="#000000" />

    <EditText
        android:id="@+id/etNamaPemilik"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginBottom="24dp"
        android:hint="Nama Pemilik (Opsional)"
        android:inputType="textCapWords"
        android:textColor="#000000" />

    <Button
        android:id="@+id/btnSimpan"
        android:layout_width="match_parent"
        android:layout_height="50dp"
        android:text="Selesai &amp; Proses"
        android:backgroundTint="#000000"
        android:textColor="#FFFFFF" />

</LinearLayout>